DATABASE_URL=postgresql://interview_user_official:<password>@postgres:5432/interview_db
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Gemini API Keys
# Add one or more Gemini API keys separated by commas.
# Single key:
# GEMINI_API_KEYS=your_api_key
#
# Multiple keys:
# GEMINI_API_KEYS=key1,key2,key3

GEMINI_API_KEYS=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# LangFuse tracing (optional — leave unset to disable)
# Get these from your LangFuse Cloud project settings.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
